{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "eslint", "unicorn"],
  "env": {
    "builtin": true,
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.wrangler/**",
    "worker-configuration.d.ts",
  ],
}
