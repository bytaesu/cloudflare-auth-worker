{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-auth-worker",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-05-14",
  "minify": true,

  "dev": {
    "local_protocol": "http",
    "upstream_protocol": "https",
    "ip": "localhost",
    "port": 3333,
    "inspector_port": 9223,
  },

  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "<your-production-domain>",
    },
  ],

  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "<your-database-name>",
      "database_id": "<your-database-id>",
      "remote": false, // flip to `true` only when applying migrations to remote database
    },
  ],
}
